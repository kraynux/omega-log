# Environnement Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Etat runtime genere localement : dossier var/ ENTIER jamais publie sur GitHub (decision
# utilisateur 2026-11-08) - donnees et config PERSONNELLES (logs suivis, sauvegardes, favoris,
# bibliotheque, reglages, declaration anonyme, sauvegardes planifiees...). omega-log recree
# le dossier au demarrage ; l'archive de release garde ses .gitkeep (build-release.sh).
var/

# Vendoring (reconstruit par build-release.sh, jamais versionne tel quel)
vendor/

# Archives de release (generees, pas du code source)
*.tar.gz

# Dependance editable omega-lib (chemin local de developpement)
omega-lib/

# Secrets locaux
.env

# Editeurs
*~
*.bak
*.swp

# Fichiers systeme
.DS_Store
Thumbs.db

# Couverture de tests
.coverage
htmlcov/

# Build / packaging
dist/
build/
