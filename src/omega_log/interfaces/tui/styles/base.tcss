/* Regles communes aux 4 profils de rendu. Portees verbatim depuis
   omega-scan/omega-stress (D-007, D-008 : meme catalogue de themes,
   memes conventions visuelles pour toute la suite omega-).

   Boutons : patron porte tel quel. Le contour rond vit EXCLUSIVEMENT sur
   ".omega-btn-frame" (un Container), jamais sur le Button lui-meme
   ("border: none" partout) : remplir le fond d'un widget au survol/focus
   peint TOUJOURS tout son rectangle, y compris l'anneau de bordure round
   — separer decoration (frame, jamais recolore) et interactivite (Button,
   fond $accent au survol/focus) evite ce bug tout en gardant un focus
   colore selon le theme. ".omega-actions"/".omega-confirm-buttons" ne
   portent PAS de contour a eux : le bouton est deja entoure par son
   propre frame, un deuxieme cadre autour du groupe est redondant. */

Screen {
    background: $background;
    color: $foreground;
}

.omega-title {
    text-style: bold;
    color: $primary;
    border: round $accent;
    padding: 0 1;
    width: auto;
    margin: 1 0;
}

.omega-subtitle {
    color: $secondary;
    padding: 0 0 1 0;
}

.omega-hint {
    color: $foreground 60%;
    padding: 0 0 1 0;
}

.omega-hidden {
    display: none;
}

.omega-panel {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

.omega-form-panel {
    padding: 1 2;
    height: 1fr;
    align-horizontal: center;
    overflow-y: auto;
}

.omega-form-panel > Select,
.omega-form-panel > Input {
    width: 70;
    margin-bottom: 1;
}

.omega-form-panel .omega-title,
.omega-form-panel .omega-subtitle,
.omega-form-panel .omega-hint {
    width: 70;
}

.omega-form-panel .omega-title {
    content-align: center middle;
}

.omega-form-panel > .omega-actions {
    width: 70;
    align: center middle;
    height: auto;
}

.omega-home-root {
    align: center middle;
    height: 1fr;
    overflow-y: auto;
}

.omega-splash-middle {
    width: 1fr;
}

.omega-splash-hero {
    color: $accent;
    text-align: left;
    width: auto;
}

.omega-splash-prompt {
    color: $secondary;
    width: auto;
    margin-top: 1;
    text-style: italic;
}

.omega-home-wordmark {
    width: auto;
    text-align: left;
    padding-bottom: 1;
}

.omega-home-menu {
    background: $panel;
    border: round $accent;
    border-title-align: center;
    border-title-color: $background;
    border-title-background: $accent;
    border-title-style: bold;
    padding: 1 4;
    width: auto;
    height: auto;
}

.omega-actions {
    align: left middle;
    height: auto;
    width: auto;
    margin-top: 1;
    overflow-x: auto;
}

.omega-btn-frame {
    border: round $accent;
    padding: 0;
    width: auto;
    height: auto;
}

.omega-home-menu .omega-btn-frame {
    width: 32;
    height: 3;
    margin-bottom: 0;
    /* 0 plutot que 1 (retour utilisateur 2026-10-04 : "reduire l'espace
       entre les elements du menu dans chaque container") — meme valeur
       deja adoptee par omega-serv pour ce meme selecteur, pas une
       improvisation : les cadres de bouton se touchent directement
       (chacun garde son propre contour rond), aucun ecran vide entre
       deux boutons consecutifs. */
}

.omega-actions Button,
.omega-confirm-buttons Button,
.omega-home-menu Button {
    background: $surface;
    border: none;
    color: $foreground;
    min-width: 10;
}

.omega-home-menu Button {
    width: 100%;
    height: 100%;
    min-width: 0;
}

.omega-actions Button.-primary,
.omega-confirm-buttons Button.-primary {
    background: $surface;
    border: none;
    color: $primary;
}

.omega-actions Button.-error,
.omega-confirm-buttons Button.-error {
    background: $surface;
    border: none;
    color: $error;
}

.omega-actions Button:hover,
.omega-confirm-buttons Button:hover,
.omega-home-menu Button:hover,
.omega-actions Button:focus,
.omega-confirm-buttons Button:focus,
.omega-home-menu Button:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.omega-actions Button.-error:hover,
.omega-confirm-buttons Button.-error:hover,
.omega-actions Button.-error:focus,
.omega-confirm-buttons Button.-error:focus {
    background: $error;
    color: $background;
    text-style: bold;
}

.omega-confirm-box {
    width: 60;
    height: auto;
    border: round $accent;
    padding: 1 2;
    align: center middle;
}

.omega-confirm-title {
    text-style: bold;
    color: $error;
    width: 60;
    content-align: center middle;
    margin-bottom: 1;
}

.omega-confirm-buttons {
    width: 60;
    height: auto;
    align: center middle;
}

.omega-progress-panel {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

.omega-progress-panel > Static {
    width: auto;
}

.omega-progress-panel LoadingIndicator {
    width: auto;
    height: 3;
}

.omega-progress-log {
    width: 80%;
    max-width: 120;
    height: 12;
    margin-top: 1;
    border: round $accent;
    background: $surface;
    color: $foreground 80%;
}

.omega-modal {
    width: 80%;
    max-width: 100;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}

.omega-role-badge {
    text-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
}

.omega-state-open { background: $success; color: $background; }
.omega-state-closed { background: $panel; color: $foreground; }
.omega-state-filtered { background: $warning; color: $background; }

DataTable {
    height: 1fr;
}

#profile-table {
    height: 10;
}

ToggleButton > .toggle--button {
    color: $foreground;
    text-style: dim;
}

ToggleButton.-on > .toggle--button {
    color: $success;
    text-style: bold;
}

/* Ajout propre a omega-log (menu principal a 2 colonnes, voir
   plan_omega_log.md §7) — absent des outils de reference a menu
   unicolonne, ajoute ici plutot que de surcharger .omega-home-menu. */
.omega-home-columns {
    height: auto;
    width: auto;
}

.omega-home-columns > .omega-home-menu {
    margin-right: 2;
}

/* Input par defaut en largeur 100% (CSS Textual) : a l'interieur d'un
   .omega-actions (Horizontal), ca pousse les boutons suivants hors de
   la zone visible/cliquable — bug reel rencontre sur screens/
   registry.py. Largeur fixe explicite plutot que de laisser le defaut
   deborder, meme raisonnement que .omega-form-panel > Input (base.tcss
   porte, deja largeur fixe 70 pour la meme raison dans un autre
   contexte). */
.omega-actions > Input {
    width: 40;
    margin-right: 1;
}

/* Viewer 1 (live_tail_screen.py) — panneau stats a gauche (largeur
   fixe), tableau a droite (flexible). Repris d'omega-fire. */
.omega-dash-box {
    border: round $accent;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
}

#stats-box {
    width: 34;
    height: 1fr;
}
